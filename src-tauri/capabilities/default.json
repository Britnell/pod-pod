{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        }
      ]
    },
    "http:allow-fetch-send",
    "http:allow-fetch-cancel-body",
    "http:allow-fetch-read-body",
    "fs:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$AUDIO/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$AUDIO/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$AUDIO/**"
        },
        {
          "path": "/Volumes/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [
        {
          "path": "/Volumes"
        },
        {
          "path": "/Volumes/**"
        }
      ]
    },
    "dialog:default"
  ]
}